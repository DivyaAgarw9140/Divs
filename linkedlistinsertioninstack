#include <stdio.h>
#include <stdlib.h>

/* create a new node

put the adddress of the first node of
above linked list in the next part of new

update the top pointer and make it
 point to the new
 node of the linked list*/

struct Node
{
    int data;
    struct Node *next;
}
*top = NULL; // global declar of top

void push(int data)
{
    // create a new node
    struct Node *new;
    new = malloc(sizeof(new));
    // memory main new node banni but abhi new node empty hai
    if (new == NULL)
    {
        printf("Overflow\n");
        exit(1);
    }
    new->data = data;
    new->next = NULL;
    new->next = top;
    top = new;
}

void print()
{
    struct Node *temp;
    temp = top;
    while (temp)
    {
        printf("%d ", temp->data);
        temp = temp->next;
    }
}
