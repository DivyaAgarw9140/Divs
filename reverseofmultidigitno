#include <stdio.h>
int revmulti(int num)
{
    int d;
    static int rev = 0;
    if (num == 0)
        return 0;
    else
    {
        d = num % 10;
        rev= rev * 10 +d;
         revmulti(num / 10);
    }
    return rev;
}
int main()
{
    int n, res;
    scanf("%d", &n);
    res = revmulti(n);
    printf("%d", res);
    return 0;
}
