#include <stdio.h>
#include <stdlib.h>

/* create a new node

put the adddress of the first node of
above linked list in the next part of new

update the top pointer and make it
 point to the new
 node of the linked list*/

struct Node
{
    int data;
    struct Node *next;
}
    *top = NULL; // global declar of top

void push(int data)
{
    // create a new node
    struct Node *new;
    new = malloc(sizeof(new));
    // memory main new node banni but abhi new node empty hai
    if (new == NULL)
    {
        printf("Overflow\n");
        exit(1);
    }
    new->data = data;
    new->next = NULL;
    new->next = top;
    top = new;
}
int isEmpty()
{
    if(top==NULL)
    return 1;
    else
    return 0;
}
int pop()
{
    // temporary pointer created
    struct Node *temp;
    temp = top;
    if (isEmpty())
    {
        printf("Stack Underflow\n");
        exit(1);
    }

    int value = temp->data;
    top = top->next;
    free(temp);
     temp=NULL;
return value;
}

void print()
{
    struct Node *temp;
    temp = top;
      if (isEmpty())
    {
        printf("Stack Underflow\n");
        exit(1);
    }
    while (temp)
    {
        printf("%d ", temp->data);
        temp = temp->next;
    }
}
int main()
{
    int choice, data, res;

    do
    {
        printf("\n 1 insertion\n");
        printf("2 deletion\n");
        printf("3 display\n");

        printf("4 exit\n");
        scanf("%d", &choice);
        switch (choice)
        {
        case 1:

            scanf(" %d", &data);
            printf("inserted %d\n", data);
            push(data);

            break;

        case 2:
            printf("deletion\n");
            res = pop();

            printf("%d ", res);
            break;

        case 3:
            print();
            break;
        case 4:
            break;
        }
    } while (choice != 4);
    return 0;
}
