// enqueue by menu-driven
#include <stdio.h>
#include<stdlib.h>
#define MAX 5
char queue[MAX];
int front = -1;
int rear = -1;

char insertion(char item)
{

    if (rear == MAX - 1)
        printf("Overflow\n");
    else
        rear = rear + 1;
    queue[rear] = item;
    if (front == -1)
    {
        front = 0;
    }
    return queue[rear];
}

char deletion()
{
    if (front == -1)
        printf("Underflow\n");
    else
    {
        // / means only one element
        char deleteditem = queue[front];
        if (front == rear)
        {
            front = -1;
            rear = -1;
        }
        else
        {
            front = front + 1;
        }
        return deleteditem;
    }
}
void traverse()
{
    if (front == -1)
        printf("queue empty\n");
    else 
    {   for (int i = front; i <= rear; i++)
        
            printf("%c \n",queue[i]);
    
    }
}
int main()
{
    char res,item;
    int choice;
 
    do
    {
        printf("1 insertion\n");
        printf("2 deletion\n");
        printf("3 display\n");

        printf("4 exit\n");
         scanf("%d", &choice);
    switch (choice)
    {
    case 1:
        
            scanf(" %c",&item);
            printf("inserted\n");
            res = insertion(item);
            printf("%c\n", res);
        break;
        
 case 2:
            printf("deletion\n");
            res = deletion();

            printf("%c ",res);
        break;
    
case 3:
traverse();
break;
case 4:
break;
    }
    }
    while(choice!=4);
        return 0;
    }
