class Solution {
public:
    vector<int> spiralOrder(vector<vector<int>>& matrix) {
        vector<int>res;
        int m,n;
        m=matrix.size();
        n=matrix[0].size();
        /* 4 directions 
        direction=0 left->right
        direction=1 top->bottom
        direction=2 right->left
         direction=3 bottom->top*/
int i=0;
int left=0;
int down=m-1; //i vala
int top=0;
int right=n-1;//j vala
int dir; // direction hai
// obvious!! conditon jo imp hai 
         while(top<=down && left<=right)
         {
           if(dir==0)
           {
            for(i=left;i<=right;i++)
           { res.push_back(matrix[top][i]);
           }
           top++;
           }

            if(dir==1)
           {
            for(i=top;i<=down;i++)
           { res.push_back(matrix[i][right]);
           }
          right--;
           }


             if(dir==2)
           {
            for(i=right;i>=left;i--)
           { res.push_back(matrix[down][i]);
           }
         down--;
           }

           if(dir==3)
           {
              for(i=down;i>=top;i--)
           { res.push_back(matrix[i][left]);
           }
         left++;
           }
dir++; /* ye isliye kyunki reppeation tou hoga hi aur
usme jab dir>3 se jyada tou dir=0 karde hum*/
           if(dir>3)
           dir=0;

           }
         
         return res;

    }
};