class Solution {
public:
    // sabse pehle ek global unordered set bana lo
    unordered_set<string> st;
   
    void builtset() {
      //  string str;
        // ab 2^p p power hai p=0 to 29 hai constraints ke equal 10^9 jaise ki

        for (int p = 0; p <= 29; p++) {
            // string main convert karne ke liye
   string  str = to_string(1<<p);
            // sort karne ke liye
            sort(begin(str), end(str));
            st.insert(str);
        } }
     
    bool reorderedPowerOf2(int n){
            // agar unordered set empty hai tou ek baar builtset() ko bula lo

            if (st.empty())           
            {  builtset();
            }
            // approach 2
            // sabse pehle /convert n string main phir sort
         string  str = to_string(n);
            sort(begin(str), end(str));
        //kya set main string present hai 
        return st.count(str);
        }
    };