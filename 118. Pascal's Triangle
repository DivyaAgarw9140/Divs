class Solution {
public:
    vector<vector<int>> generate(int numRows) 
    {
        int i,j;
     vector<vector<int>> result(numRows); 
        for(i=0;i<numRows;i++){
         result[i] = vector<int>(i+1,1);
        
            
        //now adding 
        for(j=1;j<i;j++)
            {
                result[i][j]=result[i-1][j]+result[i-1][j-1];
            } }
        return result;
    }
};