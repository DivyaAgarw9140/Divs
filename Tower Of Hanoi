#include <stdio.h>
void toh(int n, char source, char help, char des)
{
    if (n == 1)
    {
        printf("%d disk from %c to %c\n", n, source, des);
        return;
    }
    toh(n - 1, source, des, help);
    printf("%d from %c to %c\n", n, source, des);
    toh(n - 1, help, source, des);
}
int main()
{
    int n;
    scanf("%d",&n);

    toh(n, 'A', 'B', 'C');
    return 0;
}
